generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PARTICIPANT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
